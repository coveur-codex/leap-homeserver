LEAP_DATA_DIR=/data
LEAP_DATABASE_URL=sqlite:////data/database/leap.db
LEAP_SEED_DEMO_DATA=false
LEAP_ALLOW_PRIVATE_FEEDS=false
LEAP_FETCH_OPENGRAPH=false
LEAP_ADMIN_AUTH=false
LEAP_ADMIN_USERNAME=admin
LEAP_ADMIN_PASSWORD=change-me
LEAP_NEWS_RETENTION_DAYS=14
LEAP_LOG_LEVEL=INFO
LEAP_WEATHER_CACHE_MINUTES=15
LEAP_AIRCRAFT_RADIUS_NM=25
LEAP_AIRCRAFT_LIMIT=20

# Flugradar: gemeinsamer Standort-Cache, unabhängig vom Wetter
LEAP_AIRCRAFT_CACHE_SECONDS=30
